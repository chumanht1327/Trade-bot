# ── Application ──────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=bot_scalp_x
POSTGRES_USER=bot
POSTGRES_PASSWORD=changeme
DB__URL=postgresql+asyncpg://bot:changeme@localhost:5432/bot_scalp_x
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379/0

# ── MetaTrader 5 ──────────────────────────────────────────────────────────────
MT5__MOCK_MODE=true
MT5__LOGIN=0
MT5__PASSWORD=changeme
MT5__SERVER=demo.broker.com
MT5__TIMEOUT_MS=60000

# ── Risk ──────────────────────────────────────────────────────────────────────
RISK__RISK_PER_TRADE_PCT=0.25
RISK__DAILY_DD_LIMIT_PCT=2.0
RISK__WEEKLY_DD_LIMIT_PCT=5.0
RISK__MAX_CONSECUTIVE_LOSSES=5
RISK__MAX_LATENCY_MS=150.0
RISK__MAX_SPREAD_XAUUSD=3.0
RISK__MAX_SPREAD_NAS100=5.0
RISK__MAX_SPREAD_EURUSD=1.5

# ── Signals ───────────────────────────────────────────────────────────────────
SIGNAL__MIN_VOTES_REQUIRED=2
SIGNAL__EMA_FAST=9
SIGNAL__EMA_SLOW=21
SIGNAL__MOMENTUM_WINDOW_FAST=5
SIGNAL__MOMENTUM_WINDOW_SLOW=20
SIGNAL__ATR_PERIOD=14
SIGNAL__RSI_PERIOD=14

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme
